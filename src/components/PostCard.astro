---
import Thumb from './Thumb.astro';

interface Props {
  slug: string;
  title: string;
  date: Date;
  platform?: string;
  status?: string;
  summary?: string;
  tags: string[];
  cover?: string;
}

const { slug, title, date, platform, status, summary, tags, cover } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = `${base}/posts/${slug}/`;
const dateText = date.toLocaleDateString('ja-JP', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Tokyo',
});
---

<li class="card">
  <a class="card-thumb" href={href} tabindex="-1" aria-hidden="true">
    <Thumb title={title} cover={cover} label={platform} />
  </a>
  <div class="card-body">
    <div class="card-top">
      <time class="date">{dateText}</time>
      {status && <span class="badge">{status}</span>}
    </div>
    <h2><a href={href}>{title}</a></h2>
    {summary && <p>{summary}</p>}
    {tags.length > 0 && (
      <div class="meta">
        {tags.map((t) => (
          <a class="tag" href={`${base}/tags/${encodeURIComponent(t)}/`}>#{t}</a>
        ))}
      </div>
    )}
  </div>
</li>
