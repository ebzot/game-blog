---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';

interface Props {
  title?: string;
  description?: string;
  hero?: boolean; // トップページ用の大きなヘッダーを表示
}

const SITE_NAME = 'EBZOのセーブポイント';
const TAGLINE = '遊んだゲームをゆるく書き留めるブログ';
const { title, description = TAGLINE, hero = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE_NAME}` : SITE_NAME;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${base}/images/ebzo.jpg`} />
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <header class="site-header">
      <div class="container bar">
        <a class="site-title" href={`${base}/`}><span>EBZO</span>のセーブポイント</a>
        <nav class="site-nav">
          <a href={`${base}/`}>ホーム</a>
          <a href={`${base}/tags/`}>タグ</a>
          <a href={`${base}/about/`}>About</a>
        </nav>
      </div>
    </header>

    <div class="container layout">
      <main>
        <slot />
      </main>
      <Sidebar />
    </div>

    <footer class="site-footer">
      <div class="container">© {new Date().getFullYear()} {SITE_NAME}</div>
    </footer>
  </body>
</html>
